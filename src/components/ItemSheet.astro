---
// src/components/ItemSheet.astro
// Item details sheet: bottom sheet on phones, centred modal on larger screens.
// Opened from the menu (see src/scripts/item-sheet.ts). It fills itself from the menu
// catalog (#menu-data, written by CartDrawer) and the tapped tile's data attributes.
---

<dialog id="item-dialog" class="item-dialog" aria-labelledby="item-title">
    <div class="item-sheet relative bg-brand-bg text-brand-text">
        <button
            type="button"
            data-item-close
            aria-label="Close"
            class="absolute top-3 right-3 z-10 grid h-11 w-11 place-items-center rounded-full bg-white/90 text-brand-shadow shadow-sm transition hover:bg-brand-primary active:scale-90"
        >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
        </button>

        <div class="item-scroll">
            <div id="item-media" class="h-44 w-full bg-brand-primary/15 sm:h-52"></div>

            <div class="px-5 pt-5 pb-4">
                <p id="item-meta" class="text-xs font-bold uppercase tracking-widest text-brand-deep"></p>
                <h2 id="item-title" tabindex="-1" class="mt-1 text-3xl font-extrabold text-brand-shadow outline-none"></h2>
                <p id="item-desc" hidden class="mt-2 text-brand-text/70"></p>

                <fieldset id="item-sizes" hidden class="mt-5">
                    <legend class="text-xs font-bold uppercase tracking-widest text-brand-deep">Choose a size</legend>
                    <div id="item-size-list" class="mt-3 grid grid-cols-2 gap-2.5"></div>
                </fieldset>

                <p id="item-single" hidden class="mt-5 rounded-2xl bg-brand-primary/20 px-4 py-3 text-sm font-medium text-brand-text"></p>

                <fieldset id="item-extras" hidden class="mt-5">
                    <legend class="text-xs font-bold uppercase tracking-widest text-brand-deep">
                        Add extras <span class="font-medium normal-case tracking-normal text-brand-text/55">(optional)</span>
                    </legend>
                    <div id="item-extras-list" class="mt-3 grid gap-2"></div>
                </fieldset>
            </div>
        </div>

        <div class="flex items-center gap-3 border-t border-brand-shadow/10 bg-white/80 px-5 pt-4 pb-[max(1rem,env(safe-area-inset-bottom))]">
            <div class="flex shrink-0 items-center gap-1 rounded-full border border-brand-shadow/15 bg-white p-1">
                <button
                    type="button"
                    data-item-qty="-1"
                    aria-label="One less"
                    class="grid h-10 w-10 place-items-center rounded-full text-brand-shadow transition hover:bg-brand-primary/30 active:scale-90 disabled:opacity-40"
                >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14" /></svg>
                </button>
                <span id="item-qty" class="w-7 text-center font-extrabold" aria-live="polite">1</span>
                <button
                    type="button"
                    data-item-qty="1"
                    aria-label="One more"
                    class="grid h-10 w-10 place-items-center rounded-full text-brand-shadow transition hover:bg-brand-primary/30 active:scale-90 disabled:opacity-40"
                >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                </button>
            </div>
            <button
                id="item-add"
                type="button"
                class="flex min-h-12 flex-1 items-center justify-center rounded-full bg-brand-primary px-5 py-3 font-bold text-brand-text shadow-lg shadow-brand-primary/30 transition hover:bg-brand-secondary hover:text-white active:scale-[.98]"
            >
                Add to order
            </button>
        </div>
    </div>
</dialog>

<script>
    import "../scripts/item-sheet.ts";
</script>

<style>
    /* Phones: bottom sheet. Larger screens: centred modal. */
    .item-dialog {
        position: fixed;
        inset: auto 0 0 0;
        margin: 0 auto;
        width: 100%;
        max-width: 32rem;
        max-height: min(92dvh, 46rem);
        padding: 0;
        border: 0;
        background: transparent;
        color: inherit;
        overflow: visible;
    }
    .item-dialog::backdrop {
        background: rgb(26 18 8 / 0.5);
        backdrop-filter: blur(3px);
    }
    .item-sheet {
        display: flex;
        flex-direction: column;
        max-height: min(92dvh, 46rem);
        overflow: hidden;
        border-radius: 2rem 2rem 0 0;
        box-shadow: 0 -20px 60px rgb(0 0 0 / 0.25);
    }
    .item-scroll {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
    }
    .item-dialog[open] {
        animation: item-up 0.32s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .item-dialog[open]::backdrop {
        animation: item-fade 0.25s ease-out;
    }
    @media (min-width: 640px) {
        .item-dialog {
            inset: 0;
            margin: auto;
            height: fit-content;
            max-width: 30rem;
        }
        .item-sheet {
            border-radius: 2rem;
            box-shadow: 0 30px 80px rgb(0 0 0 / 0.3);
        }
        .item-dialog[open] {
            animation-name: item-pop;
        }
    }
    @keyframes item-up {
        from { transform: translateY(100%); }
        to { transform: none; }
    }
    @keyframes item-pop {
        from { opacity: 0; transform: translateY(16px) scale(0.97); }
        to { opacity: 1; transform: none; }
    }
    @keyframes item-fade {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    @media (prefers-reduced-motion: reduce) {
        .item-dialog[open],
        .item-dialog[open]::backdrop {
            animation: none;
        }
    }
</style>

<style is:global>
    /* Stop the page scrolling behind the open item sheet */
    body:has(#item-dialog[open]) {
        overflow: hidden;
    }
    /* [hidden] always wins over display utilities inside the sheet */
    #item-dialog [hidden] {
        display: none !important;
    }
    #item-dialog fieldset {
        min-width: 0;
        margin-inline: 0; /* side margins only, so the mt-5 spacing on each fieldset still applies */
        padding: 0;
        border: 0;
    }
</style>
