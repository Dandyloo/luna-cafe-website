---
// src/components/CartDrawer.astro
// Order drawer, floating "View order" button, and the menu catalog the cart reads.
// Rendered once per page by BaseLayout. The logic lives in src/scripts/cart.ts.
import menuData from "../data/menu.json";
import type { MenuData } from "../types/menu";
import { buildCatalog } from "../lib/menu";
import { WHATSAPP_NUMBER, HOURS, DELIVERY } from "../lib/config";

// Sold-out items are left out, so they also drop out of carts saved earlier.
const items = buildCatalog(menuData as unknown as MenuData)
    .filter((i) => i.available)
    .map(({ id, name, options }) => ({ id, name, options }));

const deliveryOn = DELIVERY.enabled;

const catalogJson = JSON.stringify({
    whatsapp: WHATSAPP_NUMBER,
    hours: HOURS,
    delivery: DELIVERY,
    items,
}).replace(/</g, "\\u003c");

const field =
    "mt-1.5 block w-full rounded-2xl border border-brand-shadow/15 bg-white px-4 py-3 text-base text-brand-text outline-none transition placeholder:text-brand-text/40 focus:border-brand-secondary focus:ring-2 focus:ring-brand-primary/60 aria-[invalid=true]:border-red-500";
const label = "block text-sm font-bold text-brand-shadow";
const sectionTitle = "text-xs font-bold uppercase tracking-widest text-brand-deep";
const modeCard =
    "flex h-full cursor-pointer flex-col items-center gap-1 rounded-2xl border-2 border-brand-shadow/10 bg-white px-3 py-3.5 text-center transition hover:border-brand-shadow/25 peer-checked:border-brand-primary peer-checked:bg-brand-primary/15 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-secondary";
const pillBtn =
    "mt-3 flex w-full items-center justify-center gap-2 rounded-full px-6 py-4 font-bold transition active:scale-[.98]";
---

<script type="application/json" id="menu-data" set:html={catalogJson} />

<!-- Floating button: shown once something is in the order -->
<button
    id="cart-fab"
    type="button"
    data-cart-open
    hidden
    class="fixed right-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-30 inline-flex items-center gap-3 rounded-full bg-brand-shadow py-3 pr-5 pl-4 font-bold text-brand-bg shadow-xl shadow-brand-shadow/30 transition hover:bg-brand-deep active:scale-95 sm:right-6 sm:bottom-6"
    aria-label="View your order"
>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7Z"></path><path d="M9 7a3 3 0 0 1 6 0"></path></svg>
    <span class="text-sm">View order</span>
    <span id="cart-fab-count" class="grid h-6 min-w-6 place-items-center rounded-full bg-brand-primary px-1.5 text-sm text-brand-text">0</span>
    <span id="cart-fab-total" class="text-sm text-brand-bg/75">GHS 0</span>
</button>

<dialog id="cart-dialog" class="cart-dialog" aria-labelledby="cart-title">
    <div class="cart-sheet relative bg-brand-bg text-brand-text">
        <header class="border-b border-brand-shadow/10 bg-white/60 px-5 pt-3 pb-4">
            <div class="mx-auto mb-3 h-1.5 w-12 rounded-full bg-brand-shadow/15 sm:hidden" aria-hidden="true"></div>
            <div class="flex items-center gap-3">
                <div class="min-w-0">
                    <p class="text-xs font-bold uppercase tracking-widest text-brand-deep">Luna Café &amp; Eatery</p>
                    <h2 id="cart-title" tabindex="-1" class="text-3xl font-extrabold text-brand-shadow outline-none">
                        Your order
                    </h2>
                </div>
                <div class="ml-auto flex items-center gap-2">
                    <button
                        type="button"
                        data-cart-clear
                        hidden
                        class="rounded-full px-3 py-2 text-sm font-bold text-brand-text/60 underline underline-offset-4 transition hover:bg-brand-primary/15 hover:text-brand-shadow"
                    >
                        Clear
                    </button>
                    <button
                        type="button"
                        data-cart-close
                        aria-label="Close order"
                        class="grid h-11 w-11 place-items-center rounded-full bg-brand-shadow/10 text-brand-shadow transition hover:bg-brand-primary active:scale-90"
                    >
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
                    </button>
                </div>
            </div>
        </header>

        <div
            id="cart-clear-confirm"
            hidden
            class="absolute inset-0 z-10 grid place-items-center bg-brand-shadow/35 p-5"
            role="alertdialog"
            aria-modal="true"
            aria-labelledby="cart-clear-title"
            aria-describedby="cart-clear-description"
        >
            <div class="w-full max-w-sm rounded-[2rem] bg-brand-bg p-6 text-center shadow-2xl">
                <h3 id="cart-clear-title" class="text-2xl font-extrabold text-brand-shadow">
                    Clear your order?
                </h3>
                <p id="cart-clear-description" class="mt-2 text-sm text-brand-text/70">
                    This will remove every item from your order.
                </p>
                <div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-center">
                    <button
                        type="button"
                        data-cart-clear-cancel
                        class="rounded-full border border-brand-shadow/15 px-6 py-3 font-bold text-brand-shadow transition hover:bg-brand-shadow/10"
                    >
                        Cancel
                    </button>
                    <button
                        type="button"
                        data-cart-clear-confirm
                        class="rounded-full bg-brand-secondary px-6 py-3 font-bold text-white transition hover:bg-brand-deep"
                    >
                        Clear order
                    </button>
                </div>
            </div>
        </div>

        <div class="cart-scroll px-5 py-5">
            <!-- Empty -->
            <div id="cart-empty" class="py-10 text-center">
                <div class="mx-auto grid h-20 w-20 place-items-center rounded-full bg-brand-primary/20 text-brand-deep">
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7Z"></path><path d="M9 7a3 3 0 0 1 6 0"></path></svg>
                </div>
                <p class="mt-5 text-xl font-extrabold text-brand-shadow">Your order is empty</p>
                <p class="mt-2 text-brand-text/65">Tap a price on the menu to add something.</p>
                <a
                    href="/menu"
                    data-cart-close
                    class="mt-6 inline-flex items-center justify-center rounded-full bg-brand-shadow px-7 py-3.5 font-bold text-brand-bg transition hover:bg-brand-text"
                >
                    Browse the menu
                </a>
            </div>

            <!-- Order + details -->
            <div id="cart-content" hidden>
                <!-- Items -->
                <section aria-label="Items in your order">
                    <ul id="cart-lines" class="divide-y divide-brand-shadow/10 rounded-3xl border border-brand-shadow/10 bg-white px-4"></ul>

                    <dl class="mt-3 space-y-1.5 px-2 text-sm">
                        <div class="flex items-baseline justify-between">
                            <dt class="font-semibold text-brand-text/70">Subtotal</dt>
                            <dd id="cart-subtotal" class="font-bold text-brand-shadow">GHS 0</dd>
                        </div>
                        <div id="cart-delivery-row" hidden class="flex items-baseline justify-between">
                            <dt class="font-semibold text-brand-text/70">Delivery</dt>
                            <dd id="cart-delivery-fee" class="font-bold text-brand-shadow"></dd>
                        </div>
                    </dl>
                </section>

                <form id="order-form" novalidate class="mt-6 space-y-6 border-t border-brand-shadow/10 pt-6">
                    <!-- Pickup or delivery -->
                    {deliveryOn ? (
                        <fieldset>
                            <legend class={sectionTitle}>How would you like it?</legend>
                            <div class="mt-3 grid grid-cols-2 gap-2.5">
                                <div>
                                    <input class="peer sr-only" type="radio" name="mode" id="mode-pickup" value="pickup" checked />
                                    <label for="mode-pickup" class={modeCard}>
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-brand-deep"><path d="M6 7h12l-1 13H7L6 7Z"></path><path d="M9 7a3 3 0 0 1 6 0"></path></svg>
                                        <span class="font-extrabold text-brand-shadow">Pickup</span>
                                        <span class="text-xs text-brand-text/60">Collect at the café</span>
                                    </label>
                                </div>
                                <div>
                                    <input class="peer sr-only" type="radio" name="mode" id="mode-delivery" value="delivery" />
                                    <label for="mode-delivery" class={modeCard}>
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-brand-deep"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
                                        <span class="font-extrabold text-brand-shadow">Delivery</span>
                                        <span class="text-xs text-brand-text/60">Rider calls you</span>
                                    </label>
                                </div>
                            </div>
                        </fieldset>
                    ) : (
                        <input type="hidden" name="mode" value="pickup" />
                    )}

                    <!-- Contact details -->
                    <fieldset class="space-y-4">
                        <legend class={sectionTitle}>Your details</legend>
                        <div>
                            <label for="order-name" class={label}>Your name</label>
                            <input id="order-name" name="name" type="text" autocomplete="name" maxlength="60" required class={field} />
                        </div>

                        <div>
                            <label for="order-phone" class={label}>Phone number</label>
                            <input id="order-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="20" required placeholder="024 123 4567" class={field} />
                        </div>
                    </fieldset>

                    <div id="mode-note" class="rounded-2xl bg-brand-primary/25 px-4 py-3 text-sm font-medium text-brand-text">
                        We'll notify you on WhatsApp when your order is ready for pickup.
                    </div>

                    <div>
                        <label for="order-note" class={label}>Note <span class="font-normal text-brand-text/55">(optional)</span></label>
                        <textarea id="order-note" name="note" rows="2" maxlength="200" placeholder="e.g. less ice, no onions" class={field}></textarea>
                    </div>
                </form>
            </div>

            <!-- After sending -->
            <div id="cart-success" hidden class="py-4 text-center">
                <div class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-brand-primary text-brand-text">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10"></path></svg>
                </div>
                <h3 class="mt-5 text-3xl font-extrabold text-brand-shadow">One last step</h3>
                <p class="mt-2 text-brand-text/75">
                    WhatsApp should have opened with your order. Tap <strong>Send</strong> there so Luna gets it.
                </p>

                <div class="mt-6 rounded-3xl border-2 border-dashed border-brand-shadow/25 bg-white px-5 py-4 text-left">
                    <div class="flex items-center justify-between gap-3">
                        <span class="text-xs font-bold uppercase tracking-widest text-brand-text/55">Order</span>
                        <strong id="cart-ref" class="font-heading text-2xl font-extrabold tracking-wider text-brand-shadow"></strong>
                    </div>
                    <dl class="mt-3 space-y-1.5 border-t border-dashed border-brand-shadow/20 pt-3 text-sm">
                        <div class="flex justify-between gap-4">
                            <dt class="text-brand-text/65">Type</dt>
                            <dd id="cart-success-type" class="font-bold text-brand-shadow"></dd>
                        </div>
                        <div class="flex justify-between gap-4">
                            <dt class="text-brand-text/65">Total</dt>
                            <dd id="cart-success-total" class="text-right font-bold text-brand-shadow"></dd>
                        </div>
                    </dl>
                </div>

                <ol class="mt-6 space-y-3 text-left text-sm text-brand-text/80">
                    <li class="flex items-start gap-3">
                        <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-brand-shadow text-xs font-bold text-brand-bg">1</span>
                        <span>Tap <strong>Send</strong> in WhatsApp.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-brand-shadow text-xs font-bold text-brand-bg">2</span>
                        <span>We reply to confirm your order.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-brand-shadow text-xs font-bold text-brand-bg">3</span>
                        <span id="cart-success-next"></span>
                    </li>
                </ol>

                <a
                    id="cart-wa-link"
                    href="https://wa.me/"
                    target="_blank"
                    rel="noopener"
                    class={`${pillBtn} mt-6 bg-brand-primary text-brand-text hover:bg-brand-secondary hover:text-white`}
                >
                    Open WhatsApp again
                </a>
                <button type="button" data-cart-done class={`${pillBtn} bg-brand-shadow text-brand-bg hover:bg-brand-text`}>
                    I've sent it, clear my order
                </button>
                <button type="button" data-cart-back class="mt-4 text-sm font-semibold text-brand-text/60 underline underline-offset-4 transition hover:text-brand-shadow">
                    Back to my order
                </button>
            </div>
        </div>

        <!-- Sticky total + send button (only while building an order) -->
        <div id="cart-footer" hidden class="border-t border-brand-shadow/10 bg-white/80 px-5 pt-4 pb-[max(1rem,env(safe-area-inset-bottom))] shadow-[0_-12px_30px_-20px_rgb(68_45_39/0.5)]">
            <p id="cart-error" role="alert" hidden class="mb-3 rounded-2xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-700"></p>
            <p id="cart-closed" hidden class="mb-3 rounded-2xl bg-brand-accent/30 px-4 py-3 text-sm font-medium text-brand-text"></p>

            <div class="flex items-baseline justify-between">
                <span class="font-bold text-brand-text/70">Total</span>
                <span id="cart-total" class="text-2xl font-extrabold text-brand-shadow">GHS 0</span>
            </div>
            <p id="cart-total-note" hidden class="text-right text-xs font-semibold text-brand-deep">+ delivery fee, confirmed on WhatsApp</p>
            <p id="cart-pay-note" class="mt-1 text-xs text-brand-text/55">Pay when you pick up. We confirm every order on WhatsApp.</p>
            <button
                type="submit"
                form="order-form"
                class="mt-3 flex w-full items-center justify-center gap-2 rounded-full bg-brand-primary px-6 py-4 font-bold text-brand-text shadow-lg shadow-brand-primary/30 transition hover:bg-brand-secondary hover:text-white active:scale-[.98]"
            >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3 21l1.7-5.2A8.5 8.5 0 1 1 21 12Z"></path></svg>
                <span id="cart-submit-label">Send pickup order on WhatsApp</span>
            </button>
        </div>
    </div>
</dialog>

<div id="cart-live" class="sr-only" aria-live="polite" aria-atomic="true"></div>

<script>
    import "../scripts/cart.ts";
</script>

<style>
    /* Mobile: bottom sheet. Desktop: drawer from the right. */
    .cart-dialog {
        position: fixed;
        inset: auto 0 0 0;
        margin: 0 auto;
        width: 100%;
        max-width: 32rem;
        max-height: min(92dvh, 48rem);
        padding: 0;
        border: 0;
        background: transparent;
        color: inherit;
        overflow: visible;
    }
    .cart-dialog::backdrop {
        background: rgb(26 18 8 / 0.5);
        backdrop-filter: blur(3px);
    }
    .cart-sheet {
        display: flex;
        flex-direction: column;
        max-height: min(92dvh, 48rem);
        overflow: hidden;
        border-radius: 2rem 2rem 0 0;
        box-shadow: 0 -20px 60px rgb(0 0 0 / 0.25);
    }
    .cart-scroll {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
    }
    .cart-dialog[open] {
        animation: cart-up 0.32s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .cart-dialog[open]::backdrop {
        animation: cart-fade 0.25s ease-out;
    }
    @media (min-width: 640px) {
        .cart-dialog {
            inset: 0 0 0 auto;
            margin: 0;
            max-width: 28rem;
            height: 100dvh;
            max-height: 100dvh;
        }
        .cart-sheet {
            height: 100%;
            max-height: 100dvh;
            border-radius: 2rem 0 0 2rem;
        }
        .cart-dialog[open] {
            animation-name: cart-in;
        }
    }
    @keyframes cart-up {
        from { transform: translateY(100%); }
        to { transform: none; }
    }
    @keyframes cart-in {
        from { transform: translateX(100%); }
        to { transform: none; }
    }
    @keyframes cart-fade {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    @media (prefers-reduced-motion: reduce) {
        .cart-dialog[open],
        .cart-dialog[open]::backdrop {
            animation: none;
        }
    }
</style>

<style is:global>
    /* Stop the page scrolling behind the open order drawer */
    body:has(#cart-dialog[open]) {
        overflow: hidden;
    }
    /* Make sure [hidden] always wins over display utilities */
    #cart-dialog [hidden],
    #cart-fab[hidden] {
        display: none !important;
    }
    /* Reset browser fieldset chrome so the delivery/details groups lay out like plain blocks */
    #order-form fieldset {
        min-width: 0;
        margin: 0;
        padding: 0;
        border: 0;
    }
</style>
