---
// src/pages/menu.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import menuData from "../data/menu.json";
import { itemId, normalize, optionsFor } from "../lib/menu";
import { WHATSAPP_NUMBER } from "../lib/config";

// "Savoury Bites & Drinks" -> "savoury-bites-drinks" (matches the /menu#... links on the home and about pages)
const sectionId = (name: string) =>
    name.toLowerCase().replace(/&/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");

const chatLink = `https://wa.me/${WHATSAPP_NUMBER}`;
---

<BaseLayout
    title="Menu | Luna Café & Eatery, Cape Coast"
    description="Full Luna Café menu with prices in GHS: signature boba and matcha, pizzas, shawarma, rice dishes, coffee, sandwiches and breakfast specials."
>
    <!-- Page header -->
    <section class="relative isolate overflow-hidden">
        <div class="absolute inset-0 -z-10 bg-grain"></div>
        <div
            class="absolute -top-20 left-1/2 -z-10 h-80 w-[40rem] -translate-x-1/2 rounded-full bg-brand-primary/25 blur-3xl"
        >
        </div>
        <div class="mx-auto max-w-6xl px-4 pt-32 pb-10 text-center sm:px-6 sm:pt-40">
            <p class="animate-rise text-sm font-bold uppercase tracking-widest text-brand-deep">
                Luna Café &amp; Eatery
            </p>
            <h1 class="animate-rise [animation-delay:100ms] mt-3 text-5xl font-extrabold text-brand-shadow md:text-7xl">
                Our Menu
            </h1>
            <p class="animate-rise [animation-delay:200ms] mx-auto mt-4 max-w-xl text-brand-text/70">
                Prices in GHS. Sizes: 500ml / 700ml or M / L where shown.
                <strong class="font-bold text-brand-shadow">Tap a price to add it to your order.</strong>
            </p>
        </div>
    </section>

    <!-- Menu search -->
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="rounded-[2rem] border border-brand-shadow/10 bg-white/80 p-5 shadow-sm sm:p-6">
            <label for="menu-search" class="block text-sm font-bold text-brand-shadow">
                Search the menu
            </label>
            <div class="relative mt-2">
                <input
                    id="menu-search"
                    type="search"
                    placeholder="Try “chicken”, “coffee”, or “boba”"
                    autocomplete="off"
                    class="min-h-12 w-full rounded-full border border-brand-shadow/15 bg-brand-bg py-3 px-5 text-brand-text placeholder:text-brand-text/45 focus:border-brand-secondary focus:outline-none"
                />
            </div>
            <p id="menu-search-status" class="mt-3 text-sm text-brand-text/60" aria-live="polite">
                Showing all menu items
            </p>
        </div>
    </div>

    <!-- Menu sections -->
    <div class="mx-auto max-w-6xl space-y-20 px-4 pt-14 sm:px-6 sm:space-y-28">
        {
            menuData.map((category, i) => (
                <section id={sectionId(category.name)} data-menu-category class="scroll-mt-28">
                    <div class="reveal flex items-end gap-4 border-b border-brand-shadow/10 pb-5">
                        <span class="font-heading text-lg font-bold text-brand-secondary">
                            0{i + 1}
                        </span>
                        <h2 class="text-4xl font-extrabold text-brand-shadow md:text-5xl">
                            {category.name}
                        </h2>
                    </div>

                    <div class="mt-10 grid gap-5 lg:grid-cols-2">
                        {category.groups.map((group, gi) => (
                            <div
                                data-menu-group
                                style={`--d:${(gi % 2) * 120}ms`}
                                class="reveal rounded-[2rem] border border-brand-shadow/10 bg-white/80 p-6 shadow-sm transition hover:shadow-xl hover:shadow-brand-shadow/10 sm:p-8"
                            >
                                <h3 class="flex items-center gap-3 text-xl font-extrabold text-brand-shadow md:text-2xl">
                                    <span class="h-2 w-2 rounded-full bg-brand-secondary" />
                                    {group.name}
                                </h3>

                                <ul class="mt-5 divide-y divide-brand-shadow/10">
                                    {group.items.map((item: any) => {
                                        const id = itemId(group.name, item.name);
                                        const options = optionsFor(item);
                                        const available = item.available !== false;
                                        return (
                                            <li
                                                data-menu-item
                                                data-search-text={normalize(
                                                    `${category.name} ${group.name} ${item.name} ${item.description ?? ""}`,
                                                )}
                                                class="flex items-center justify-between gap-4 py-3"
                                            >
                                                <div class="min-w-0">
                                                    <p class="font-semibold text-brand-text">
                                                        {item.name}
                                                    </p>
                                                    {item.description && (
                                                        <p class="mt-0.5 text-sm text-brand-text/60">
                                                            {item.description}
                                                        </p>
                                                    )}
                                                </div>

                                                <div class="flex shrink-0 flex-wrap justify-end gap-1.5">
                                                    {available ? (
                                                        options.map((o) => (
                                                            <button
                                                                type="button"
                                                                data-add
                                                                data-id={id}
                                                                data-opt={o.k}
                                                                aria-label={`Add ${item.name}${o.label ? ` ${o.label}` : ""}, GHS ${o.price}, to your order`}
                                                                class="inline-flex min-h-10 items-center gap-1.5 rounded-full bg-brand-primary/15 py-1 pr-1.5 pl-3 text-sm font-bold text-brand-deep transition hover:bg-brand-primary active:scale-95"
                                                            >
                                                                {o.label && (
                                                                    <span class="text-[0.65rem] font-semibold uppercase tracking-wide text-brand-text/55">
                                                                        {o.label}
                                                                    </span>
                                                                )}
                                                                <span>GHS {o.price}</span>
                                                                <span aria-hidden="true" class="grid h-7 w-7 place-items-center rounded-full bg-brand-shadow text-base leading-none text-brand-bg">
                                                                    +
                                                                </span>
                                                            </button>
                                                        ))
                                                    ) : (
                                                        <span class="text-sm font-semibold text-brand-text/50">
                                                            Sold out
                                                        </span>
                                                    )}
                                                </div>
                                            </li>
                                        );
                                    })}
                                </ul>
                            </div>
                        ))}
                    </div>
                </section>
            ))
        }
    </div>

    <!-- Order CTA -->
    <section class="reveal mx-auto mt-24 max-w-6xl px-4 sm:px-6">
        <div class="flex flex-col items-center justify-between gap-6 rounded-[2.5rem] bg-brand-shadow px-8 py-10 text-center text-brand-bg sm:flex-row sm:px-12 sm:text-left">
            <div>
                <h2 class="text-3xl font-extrabold">Ready to order?</h2>
                <p class="mt-2 text-brand-bg/70">
                    Tap prices above to build your order, then choose pickup or delivery and send it to us on WhatsApp.
                </p>
            </div>
            <div class="flex shrink-0 flex-col items-center gap-3 sm:items-end">
                <button
                    type="button"
                    data-cart-open
                    class="rounded-full bg-brand-primary px-8 py-4 font-bold text-brand-text transition hover:-translate-y-0.5 hover:bg-brand-secondary hover:text-white"
                >
                    View my order
                </button>
                <a
                    href={chatLink}
                    target="_blank"
                    rel="noopener"
                    class="text-sm font-semibold text-brand-bg/70 underline underline-offset-4 transition hover:text-brand-primary"
                >
                    Or just chat with us on WhatsApp
                </a>
            </div>
        </div>
    </section>
</BaseLayout>

<script>
    const normalizeSearch = (text: string) =>
        text
            .toLowerCase()
            .normalize("NFKD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/[^a-z0-9]+/g, " ")
            .trim();

    function initMenuSearch() {
        const input = document.getElementById("menu-search") as HTMLInputElement | null;
        const status = document.getElementById("menu-search-status");
        if (!input || !status) return;

        const items = [...document.querySelectorAll<HTMLElement>("[data-menu-item]")];
        const groups = [...document.querySelectorAll<HTMLElement>("[data-menu-group]")];
        const categories = [...document.querySelectorAll<HTMLElement>("[data-menu-category]")];

        const update = () => {
            const query = normalizeSearch(input.value);
            const terms = query ? query.split(/\s+/) : [];
            let visibleCount = 0;

            items.forEach((item) => {
                const searchable = item.dataset.searchText ?? "";
                const matches = terms.every((term) => searchable.includes(term));
                item.hidden = !matches;
                if (matches) visibleCount++;
            });

            groups.forEach((group) => {
                group.hidden = !group.querySelector("[data-menu-item]:not([hidden])");
            });
            categories.forEach((category) => {
                category.hidden = !category.querySelector("[data-menu-group]:not([hidden])");
            });

            status.textContent = query
                ? visibleCount === 0
                    ? `No menu items found for “${input.value.trim()}”`
                    : `${visibleCount} menu item${visibleCount === 1 ? "" : "s"} found`
                : "Showing all menu items";
        };

        input.addEventListener("input", update);
        update();
    }

    document.addEventListener("astro:page-load", initMenuSearch);
</script>
