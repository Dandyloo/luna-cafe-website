---
// src/pages/menu.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import ItemSheet from "../components/ItemSheet.astro";
import menuData from "../data/menu.json";
import { displayGroupName, extrasFor, itemId, itemInitial, normalize, optionsFor, priceSummary } from "../lib/menu";
import { WHATSAPP_NUMBER } from "../lib/config";

// "Savoury Bites & Drinks" -> "savoury-bites-drinks" (matches the /menu#... links on the home and about pages)
const sectionId = (name: string) =>
    name.toLowerCase().replace(/&/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
const groupSectionId = (name: string) => `g-${sectionId(displayGroupName(name))}`;

// One chip per menu group, in menu order, for the sticky category bar
const chips = menuData.flatMap((category) =>
    category.groups.map((group) => ({
        id: groupSectionId(group.name),
        label: displayGroupName(group.name),
    })),
);

const chatLink = `https://wa.me/${WHATSAPP_NUMBER}`;
---

<BaseLayout
    title="Menu | Luna Café & Eatery, Cape Coast"
    description="Full Luna Café menu with prices in GHS: signature boba and matcha, pizzas, shawarma, rice dishes, coffee, sandwiches and breakfast specials."
>
    <!-- Page header -->
    <section class="relative isolate overflow-hidden">
        <div class="absolute inset-0 -z-10 bg-grain"></div>
        <div
            class="absolute -top-20 left-1/2 -z-10 h-80 w-[40rem] -translate-x-1/2 rounded-full bg-brand-primary/25 blur-3xl"
        >
        </div>
        <div class="mx-auto max-w-6xl px-4 pt-32 pb-8 text-center sm:px-6 sm:pt-40">
            <p class="animate-rise text-sm font-bold uppercase tracking-widest text-brand-deep">
                Luna Café &amp; Eatery
            </p>
            <h1 class="animate-rise [animation-delay:100ms] mt-3 text-5xl font-extrabold text-brand-shadow md:text-7xl">
                Our Menu
            </h1>
            <p class="animate-rise [animation-delay:200ms] mx-auto mt-4 max-w-xl text-brand-text/70">
                Prices in GHS.
                <strong class="font-bold text-brand-shadow">Pick what you like and add it to your order.</strong>
            </p>
        </div>
    </section>

    <!-- Menu search -->
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="rounded-[2rem] border border-brand-shadow/10 bg-white/80 p-4 shadow-sm sm:p-5">
            <label for="menu-search" class="block text-sm font-bold text-brand-shadow">
                Search the menu
            </label>
            <div class="relative mt-2">
                <input
                    id="menu-search"
                    type="search"
                    placeholder="Try “chicken”, “coffee”, or “boba”"
                    autocomplete="off"
                    class="min-h-12 w-full rounded-full border border-brand-shadow/15 bg-brand-bg py-3 px-5 text-brand-text placeholder:text-brand-text/45 focus:border-brand-secondary focus:outline-none"
                />
            </div>
            <p id="menu-search-status" class="mt-3 text-sm text-brand-text/60" aria-live="polite">
                Showing all menu items
            </p>
        </div>
    </div>

    <!-- Sticky category bar: scrolls sideways, highlights the section you're reading -->
    <div
        id="menu-chips"
        class="sticky top-[5.9rem] z-30 mt-6 bg-brand-bg/85 py-2.5 backdrop-blur-md sm:top-[6.9rem] lg:hidden"
    >
        <div class="mx-auto max-w-6xl px-4 sm:px-6">
            <nav aria-label="Menu categories">
                <ul data-chip-scroller class="chip-scroller flex gap-2 overflow-x-auto py-1">
                    {
                        chips.map((chip, i) => (
                            <li class="shrink-0 snap-center">
                                <a
                                    href={`#${chip.id}`}
                                    data-chip={chip.id}
                                    aria-current={i === 0 ? "true" : undefined}
                                    class="chip inline-flex min-h-10 items-center rounded-full border border-brand-shadow/15 bg-white px-4 text-sm font-bold text-brand-shadow transition hover:border-brand-shadow/30 active:scale-95"
                                >
                                    {chip.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>
        </div>
    </div>

    <!-- Menu: on large screens a category rail sits beside the sections -->
    <div class="mx-auto max-w-6xl px-4 pt-8 sm:px-6 lg:grid lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-10">
        <aside class="hidden lg:block">
            <nav
                aria-label="Menu sections"
                data-rail-nav
                class="sticky top-32 max-h-[calc(100dvh-9rem)] overflow-y-auto pr-2 pb-6"
            >
                {
                    menuData.map((category) => (
                        <div data-rail-category class="mb-6">
                            <p class="px-3 text-xs font-bold uppercase tracking-widest text-brand-deep">
                                {category.name}
                            </p>
                            <ul class="mt-2 space-y-0.5">
                                {category.groups.map((group) => (
                                    <li>
                                        <a
                                            href={`#${groupSectionId(group.name)}`}
                                            data-rail={groupSectionId(group.name)}
                                            class="rail-link block rounded-xl px-3 py-2 text-sm font-semibold text-brand-text/75 transition hover:bg-brand-primary/15 hover:text-brand-shadow"
                                        >
                                            {displayGroupName(group.name)}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </nav>
        </aside>

        <div class="min-w-0 space-y-16 sm:space-y-20">
        {
            menuData.map((category, i) => (
                <section id={sectionId(category.name)} data-menu-category class="scroll-mt-48 lg:scroll-mt-32">
                    <div class="reveal flex items-end gap-4 border-b border-brand-shadow/10 pb-4">
                        <span class="font-heading text-lg font-bold text-brand-secondary">
                            0{i + 1}
                        </span>
                        <h2 class="text-4xl font-extrabold text-brand-shadow md:text-5xl">
                            {category.name}
                        </h2>
                    </div>

                    <div class="mt-6 space-y-10">
                        {category.groups.map((group) => (
                            <section
                                id={groupSectionId(group.name)}
                                data-menu-group
                                aria-labelledby={`${groupSectionId(group.name)}-title`}
                                class="scroll-mt-48 lg:scroll-mt-32"
                            >
                                <h3
                                    id={`${groupSectionId(group.name)}-title`}
                                    class="reveal flex items-center gap-3 text-2xl font-extrabold text-brand-shadow"
                                >
                                    <span class="h-2 w-2 rounded-full bg-brand-secondary" />
                                    {displayGroupName(group.name)}
                                </h3>

                                <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                                    {group.items.map((item: any) => {
                                        const id = itemId(group.name, item.name);
                                        const options = optionsFor(item);
                                        const available = item.available !== false;
                                        // Items that take extras (the boba drinks) always open the item sheet
                                        const hasExtras = extrasFor(category as any).length > 0;
                                        return (
                                            <li
                                                data-menu-item
                                                data-item-id={id}
                                                data-group={displayGroupName(group.name)}
                                                data-desc={item.description ?? undefined}
                                                data-image={item.image ?? undefined}
                                                data-search-text={normalize(
                                                    `${category.name} ${displayGroupName(group.name)} ${item.name} ${item.description ?? ""}`,
                                                )}
                                                class:list={[
                                                    "reveal relative flex gap-3 rounded-2xl border border-brand-shadow/10 bg-white/90 p-3 shadow-sm transition",
                                                    available
                                                        ? "hover:shadow-lg hover:shadow-brand-shadow/10"
                                                        : "opacity-60",
                                                ]}
                                            >
                                                {item.image ? (
                                                    <img
                                                        src={item.image}
                                                        alt=""
                                                        width="64"
                                                        height="64"
                                                        loading="lazy"
                                                        decoding="async"
                                                        class="h-16 w-16 shrink-0 rounded-xl object-cover"
                                                    />
                                                ) : (
                                                    <div
                                                        aria-hidden="true"
                                                        class="grid h-16 w-16 shrink-0 place-items-center rounded-xl bg-brand-primary/15 font-heading text-2xl font-extrabold text-brand-deep"
                                                    >
                                                        {itemInitial(item.name)}
                                                    </div>
                                                )}

                                                <div class="min-w-0 flex-1">
                                                    <p class="font-semibold leading-snug text-brand-text">
                                                        {available ? (
                                                            <button
                                                                type="button"
                                                                data-open-item
                                                                class="text-left after:absolute after:inset-0 after:rounded-2xl after:content-[''] focus-visible:outline-none focus-visible:after:ring-2 focus-visible:after:ring-brand-secondary"
                                                            >
                                                                {item.name}
                                                            </button>
                                                        ) : (
                                                            item.name
                                                        )}
                                                    </p>
                                                    {item.description && (
                                                        <p class="mt-0.5 text-sm text-brand-text/60">
                                                            {item.description}
                                                        </p>
                                                    )}
                                                    <p
                                                        class:list={[
                                                            "mt-0.5 text-sm font-bold",
                                                            available ? "text-brand-deep" : "text-brand-text/50",
                                                        ]}
                                                    >
                                                        {available ? priceSummary(options) : "Sold out"}
                                                    </p>
                                                </div>

                                                {available && options.length === 1 && !hasExtras && (
                                                    <button
                                                        type="button"
                                                        data-add
                                                        data-id={id}
                                                        data-opt={options[0].k}
                                                        aria-label={`Add ${item.name}${options[0].label ? ` ${options[0].label}` : ""}, GHS ${options[0].price}, to your order`}
                                                        class="relative z-10 grid h-11 w-11 shrink-0 place-items-center self-center rounded-full bg-brand-shadow text-brand-bg transition hover:bg-brand-primary hover:text-brand-text active:scale-90"
                                                    >
                                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                                                    </button>
                                                )}
                                                {available && (options.length > 1 || hasExtras) && (
                                                    <button
                                                        type="button"
                                                        data-open-item
                                                        aria-hidden="true"
                                                        tabindex="-1"
                                                        class="relative z-10 grid h-11 w-11 shrink-0 place-items-center self-center rounded-full bg-brand-shadow text-brand-bg transition hover:bg-brand-primary hover:text-brand-text active:scale-90"
                                                    >
                                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                                                    </button>
                                                )}
                                            </li>
                                        );
                                    })}
                                </ul>
                            </section>
                        ))}
                    </div>
                </section>
            ))
        }
        </div>
    </div>

    <!-- Order CTA -->
    <section class="reveal mx-auto mt-24 max-w-6xl px-4 sm:px-6">
        <div class="flex flex-col items-center justify-between gap-6 rounded-[2.5rem] bg-brand-shadow px-8 py-10 text-center text-brand-bg sm:flex-row sm:px-12 sm:text-left">
            <div>
                <h2 class="text-3xl font-extrabold">Ready to order?</h2>
                <p class="mt-2 text-brand-bg/70">
                    Add items above to build your order, then choose pickup or delivery and send it to us on WhatsApp.
                </p>
            </div>
            <div class="flex shrink-0 flex-col items-center gap-3 sm:items-end">
                <button
                    type="button"
                    data-cart-open
                    class="rounded-full bg-brand-primary px-8 py-4 font-bold text-brand-text transition hover:-translate-y-0.5 hover:bg-brand-secondary hover:text-white"
                >
                    View my order
                </button>
                <a
                    href={chatLink}
                    target="_blank"
                    rel="noopener"
                    class="text-sm font-semibold text-brand-bg/70 underline underline-offset-4 transition hover:text-brand-primary"
                >
                    Or just chat with us on WhatsApp
                </a>
            </div>
        </div>
    </section>

    <ItemSheet />
</BaseLayout>

<style>
    /* Smooth sideways scroll with soft fades at both edges; scrollbar hidden */
    .chip-scroller {
        scroll-behavior: smooth;
        scroll-snap-type: x proximity;
        overscroll-behavior-x: contain;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        -webkit-mask-image: linear-gradient(to right, transparent 0, #000 20px, #000 calc(100% - 20px), transparent 100%);
        mask-image: linear-gradient(to right, transparent 0, #000 20px, #000 calc(100% - 20px), transparent 100%);
        padding-inline: 20px;
    }
    .chip-scroller::-webkit-scrollbar {
        display: none;
    }
    .chip[aria-current="true"] {
        background-color: var(--color-brand-shadow);
        border-color: var(--color-brand-shadow);
        color: var(--color-brand-bg);
    }
    .rail-link[aria-current="true"] {
        background-color: var(--color-brand-shadow);
        color: var(--color-brand-bg);
    }
    @media (prefers-reduced-motion: reduce) {
        .chip-scroller {
            scroll-behavior: auto;
        }
    }
</style>

<script>
    const normalizeSearch = (text: string) =>
        text
            .toLowerCase()
            .normalize("NFKD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/[^a-z0-9]+/g, " ")
            .trim();

    const reduceMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let cleanup: (() => void) | null = null;

    function initMenu() {
        cleanup?.();
        cleanup = null;

        const input = document.getElementById("menu-search") as HTMLInputElement | null;
        const status = document.getElementById("menu-search-status");
        const bar = document.getElementById("menu-chips");
        const scroller = document.querySelector<HTMLElement>("[data-chip-scroller]");
        if (!input || !status || !bar || !scroller) return;

        const items = [...document.querySelectorAll<HTMLElement>("[data-menu-item]")];
        const groups = [...document.querySelectorAll<HTMLElement>("[data-menu-group]")];
        const categories = [...document.querySelectorAll<HTMLElement>("[data-menu-category]")];
        const chips = [...scroller.querySelectorAll<HTMLAnchorElement>("[data-chip]")];
        const chipFor = new Map(chips.map((c) => [c.dataset.chip ?? "", c]));
        // Large screens: the vertical rail does the same job as the chips
        const railNav = document.querySelector<HTMLElement>("[data-rail-nav]");
        const railLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-rail]")];
        const railFor = new Map(railLinks.map((a) => [a.dataset.rail ?? "", a]));
        const railCategories = [...document.querySelectorAll<HTMLElement>("[data-rail-category]")];

        /* ---- chips: highlight + keep the active one centred ---- */
        let activeId = "";
        const setActive = (id: string) => {
            if (!id || id === activeId) return;
            activeId = id;
            chips.forEach((c) => {
                if (c.dataset.chip === id) c.setAttribute("aria-current", "true");
                else c.removeAttribute("aria-current");
            });
            railLinks.forEach((a) => {
                if (a.dataset.rail === id) a.setAttribute("aria-current", "true");
                else a.removeAttribute("aria-current");
            });
            const railLink = railFor.get(id);
            if (railNav && railLink && railNav.offsetParent !== null) {
                const top = railLink.offsetTop;
                const out = top < railNav.scrollTop + 8 || top + railLink.offsetHeight > railNav.scrollTop + railNav.clientHeight - 8;
                if (out) railNav.scrollTo({ top: Math.max(0, top - railNav.clientHeight / 2), behavior: reduceMotion() ? "auto" : "smooth" });
            }
            const chip = chipFor.get(id);
            if (!chip) return;
            const left = chip.offsetLeft - (scroller.clientWidth - chip.offsetWidth) / 2;
            scroller.scrollTo({ left: Math.max(0, left), behavior: reduceMotion() ? "auto" : "smooth" });
        };

        // The "reading line" sits just under the sticky chips (phones/tablets) or the header (rail on large screens)
        const readingLine = () => (bar.offsetParent !== null ? bar.getBoundingClientRect().bottom + 24 : 150);
        let lockUntil = 0;
        let frame = 0;
        const spy = () => {
            frame = 0;
            if (Date.now() < lockUntil) return; // a chip click is smooth-scrolling the page
            const line = readingLine();
            let current = "";
            for (const g of groups) {
                if (g.hidden) continue;
                if (g.getBoundingClientRect().top <= line) current = g.id;
                else break;
            }
            if (!current) current = groups.find((g) => !g.hidden)?.id ?? "";
            setActive(current);
        };
        const onScroll = () => {
            if (!frame) frame = requestAnimationFrame(spy);
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);

        const onChipClick = (e: Event) => {
            const link = (e.target as HTMLElement).closest<HTMLAnchorElement>("[data-chip], [data-rail]");
            if (!link) return;
            e.preventDefault();
            const id = link.dataset.chip ?? link.dataset.rail ?? "";
            const target = document.getElementById(id);
            if (!target) return;
            lockUntil = Date.now() + 900;
            setActive(target.id);
            target.scrollIntoView({ behavior: reduceMotion() ? "auto" : "smooth", block: "start" });
        };
        scroller.addEventListener("click", onChipClick);
        railNav?.addEventListener("click", onChipClick);

        /* ---- search ---- */
        const update = () => {
            const query = normalizeSearch(input.value);
            const terms = query ? query.split(/\s+/) : [];
            let visibleCount = 0;

            items.forEach((item) => {
                const searchable = item.dataset.searchText ?? "";
                const matches = terms.every((term) => searchable.includes(term));
                item.hidden = !matches;
                if (matches) visibleCount++;
            });

            groups.forEach((group) => {
                group.hidden = !group.querySelector("[data-menu-item]:not([hidden])");
                const chip = chipFor.get(group.id);
                if (chip?.parentElement) chip.parentElement.hidden = group.hidden;
                const railLink = railFor.get(group.id);
                if (railLink?.parentElement) railLink.parentElement.hidden = group.hidden;
            });
            railCategories.forEach((c) => {
                c.hidden = !c.querySelector("li:not([hidden])");
            });
            categories.forEach((category) => {
                category.hidden = !category.querySelector("[data-menu-group]:not([hidden])");
            });

            status.textContent = query
                ? visibleCount === 0
                    ? `No menu items found for “${input.value.trim()}”`
                    : `${visibleCount} menu item${visibleCount === 1 ? "" : "s"} found`
                : "Showing all menu items";

            bar.hidden = visibleCount === 0;
            activeId = "";
            onScroll();
        };

        input.addEventListener("input", update);
        update();

        cleanup = () => {
            window.removeEventListener("scroll", onScroll);
            window.removeEventListener("resize", onScroll);
            scroller.removeEventListener("click", onChipClick);
            railNav?.removeEventListener("click", onChipClick);
            input.removeEventListener("input", update);
            if (frame) cancelAnimationFrame(frame);
        };
    }

    document.addEventListener("astro:page-load", initMenu);
    document.addEventListener("astro:before-swap", () => {
        cleanup?.();
        cleanup = null;
    });
</script>
