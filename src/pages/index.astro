---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";

const whatsapp =
	"https://wa.me/233593676875?text=Hi%20Luna%2C%20I%27d%20like%20to%20order...";

// Hero card deck: flips through these every 5 seconds (files live in /public)
const heroSlides = [
	{ src: "/macha-hero.avif", alt: "Fresh matcha drink at Luna Café" },
	{ src: "/shawarma-hero.avif", alt: "Loaded shawarma at Luna Café" },
	{ src: "/pizza-hero.avif", alt: "Luna Special Pizza at Luna Café" },
];

const ticker = [
	"Brown Sugar Boba",
	"Shawarma",
	"Luna Blue",
	"Jollof Rice",
	"Cappuccino",
	"Luna Special Pizza",
	"Matcha",
	"Club Sandwich",
	"Iced Latte",
	"Fresh Pastries",
];

const offers = [
	{
		n: "01",
		title: "Luna Boba",
		text: "Milk teas, fruit teas, signature boba and matcha, shaken fresh and loaded with toppings.",
		href: "/menu#luna-boba",
		cta: "See boba menu",
		from: "from GHS 40",
		tone: "bg-brand-primary text-brand-text",
		span: "lg:col-span-2",
	},
	{
		n: "02",
		title: "Savoury Bites",
		text: "Pizzas, rice dishes, shawarma, pastries, salads and soft drinks.",
		href: "/menu#savoury-bites-drinks",
		cta: "See savoury menu",
		from: "from GHS 10",
		tone: "bg-white text-brand-text",
		span: "",
	},
	{
		n: "03",
		title: "Coffee & Breakfast",
		text: "Espresso drinks, iced coffee, hot drinks, sandwiches and breakfast specials.",
		href: "/menu#coffee-breakfast",
		cta: "See breakfast menu",
		from: "from GHS 20",
		tone: "bg-brand-shadow text-brand-bg",
		span: "lg:col-span-3",
	},
];
---

<BaseLayout title="Luna Café & Eatery – Home">
	<!-- Hero: starts at the very top so the gradient runs behind the fixed nav -->
	<section class="relative isolate overflow-hidden">
		<div class="absolute inset-0 -z-10 bg-grain"></div>
		<div
			class="absolute -top-40 -right-32 -z-10 h-[34rem] w-[34rem] rounded-full bg-brand-primary/30 blur-3xl"
		>
		</div>
		<div
			class="absolute -bottom-32 -left-24 -z-10 h-[24rem] w-[24rem] rounded-full bg-brand-accent/40 blur-3xl"
		>
		</div>

		<div
			class="mx-auto max-w-6xl px-4 pt-32 pb-20 sm:px-6 sm:pt-40 sm:pb-28"
		>
			<div class="grid items-center gap-14 lg:grid-cols-[1.1fr_0.9fr]">
				<div class="hero-stagger">
					<div
						class="inline-flex items-center gap-2 rounded-full border border-brand-shadow/10 bg-white/70 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-brand-deep backdrop-blur"
					>
						<span class="relative flex h-2 w-2">
							<span
								class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-primary opacity-75"
							></span>
							<span
								class="relative inline-flex h-2 w-2 rounded-full bg-brand-primary"
							></span>
						</span>
						Open daily · Pedu, Cape Coast
					</div>

					<h1
						class="mt-6 text-5xl font-extrabold text-brand-shadow sm:text-6xl md:text-7xl"
					>
						Boba, bites &amp; <span class="text-brand-secondary"
							>coffee</span
						>, all under one roof.
					</h1>

					<p
						class="mt-6 max-w-xl text-lg text-brand-text/75 sm:text-xl"
					>
						Luna Café &amp; Eatery is your cozy corner for shawarma,
						pizza, fresh coffee and signature boba. Perfect for
						takeout and quick bites.
					</p>

					<div class="mt-10 flex flex-col gap-3 sm:flex-row">
						<a
							href="/menu"
							class="group inline-flex items-center justify-center gap-2 rounded-full bg-brand-shadow px-8 py-4 font-bold text-brand-bg shadow-lg shadow-brand-shadow/20 transition hover:-translate-y-0.5 hover:bg-brand-text"
						>
							View menu
							<span class="transition group-hover:translate-x-1"
								>→</span
							>
						</a>
						<a
							href={whatsapp}
							target="_blank"
							rel="noopener"
							class="inline-flex items-center justify-center rounded-full bg-brand-primary px-8 py-4 font-bold text-brand-text shadow-lg shadow-brand-primary/30 transition hover:-translate-y-0.5 hover:bg-brand-secondary hover:text-white"
						>
							Order on WhatsApp
						</a>
					</div>
				</div>

				<!-- Hero image slot -->
				<div class="reveal relative mx-auto w-full max-w-md lg:max-w-none" style="--d:200ms">
					<div
						class="absolute inset-0 translate-x-3 translate-y-3 rotate-3 rounded-[2.5rem] bg-brand-primary"
						aria-hidden="true"
					>
					</div>
					<div id="hero-deck" class="hero-deck relative aspect-[4/5]">
						{
							heroSlides.map((s, i) => (
								<div
									data-pos={i}
									aria-hidden={i === 0 ? undefined : "true"}
									class="hero-card absolute inset-0 overflow-hidden rounded-[2.5rem] border border-brand-shadow/10 bg-gradient-to-br from-brand-accent/60 to-brand-primary/40 shadow-2xl shadow-brand-shadow/20"
								>
									<img
										src={s.src}
										alt={s.alt}
										width="800"
										height="1000"
										fetchpriority={i === 0 ? "high" : undefined}
										decoding="async"
										class="parallax-img h-full w-full object-cover"
										onerror="this.style.display='none'"
									/>
								</div>
							))
						}
						<div class="pointer-events-none absolute inset-x-0 bottom-5 z-10 flex justify-center" aria-hidden="true">
							<div class="flex items-center gap-2 rounded-full bg-white/70 px-3 py-2 backdrop-blur">
								{
									heroSlides.map((_, i) => (
										<span class:list={["hero-dot", i === 0 && "is-active"]} />
									))
								}
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Quick facts -->
			<dl class="mt-16 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
				{
					[
						["30", "Boba drinks"],
						["8am", "Opens daily"],
						["3", "Menu collections"],
						["GHS 10", "Prices start at"],
					].map(([value, label], i) => (
						<div style={`--d:${i * 80}ms`} class="reveal rounded-3xl border border-brand-shadow/10 bg-white/70 p-5 backdrop-blur">
							<dt class="font-heading text-3xl font-extrabold text-brand-secondary">
								{value}
							</dt>
							<dd class="mt-1 text-sm font-medium text-brand-text/65">
								{label}
							</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<!-- Marquee -->
	<section
		class="overflow-hidden border-y border-brand-shadow/10 bg-brand-shadow py-4 text-brand-bg"
		aria-hidden="true"
	>
		<div class="flex w-max animate-marquee gap-10 whitespace-nowrap">
			{
				[...ticker, ...ticker].map((item) => (
					<span class="flex items-center gap-10 font-heading text-lg font-bold">
						{item}
						<span class="h-1.5 w-1.5 rounded-full bg-brand-primary" />
					</span>
				))
			}
		</div>
	</section>

	<!-- What we offer -->
	<section class="mx-auto max-w-6xl px-4 pt-20 sm:px-6 sm:pt-28">
		<div class="reveal max-w-2xl">
			<p
				class="text-sm font-bold uppercase tracking-widest text-brand-deep"
			>
				What we offer
			</p>
			<h2
				class="mt-3 text-4xl font-extrabold text-brand-shadow md:text-5xl"
			>
				Something for every craving.
			</h2>
		</div>

		<div class="mt-12 grid gap-4 sm:gap-5 lg:grid-cols-3">
			{
				offers.map((o, i) => (
					<a
						href={o.href}
						style={`--d:${i * 100}ms`}
						class:list={[
							"group relative flex flex-col justify-between overflow-hidden rounded-[2rem] border border-brand-shadow/10 p-8 transition duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-brand-shadow/15",
							o.tone,
							"reveal",
							o.span,
						]}
					>
						<div>
							<span class="font-heading text-sm font-bold opacity-50">
								{o.n}
							</span>
							<h3 class="mt-6 text-3xl font-extrabold sm:text-4xl">
								{o.title}
							</h3>
							<p class="mt-3 max-w-md opacity-80">{o.text}</p>
						</div>
						<div class="mt-10 flex items-center justify-between text-sm font-bold">
							<span class="rounded-full bg-black/10 px-3 py-1">
								{o.from}
							</span>
							<span class="inline-flex items-center gap-2">
								{o.cta}
								<span class="grid h-8 w-8 place-items-center rounded-full bg-black/10 transition group-hover:translate-x-1 group-hover:bg-black/20">
									→
								</span>
							</span>
						</div>
					</a>
				))
			}
		</div>
	</section>

	<!-- CTA band -->
	<section class="reveal mx-auto mt-20 max-w-6xl px-4 sm:mt-28 sm:px-6">
		<div
			class="relative overflow-hidden rounded-[2.5rem] bg-brand-primary px-8 py-14 text-center sm:px-16 sm:py-20"
		>
			<div class="absolute inset-0 bg-grain opacity-60"></div>
			<div class="relative">
				<h2
					class="mx-auto max-w-2xl text-4xl font-extrabold text-brand-text md:text-5xl"
				>
					Hungry? Skip the queue and order on WhatsApp.
				</h2>
				<p class="mx-auto mt-4 max-w-lg text-brand-text/75">
					Send us your order and we'll have it ready when you arrive.
					Open Mon–Thu 8:00–22:00 and Fri–Sun 8:00–23:00.
				</p>
				<a
					href={whatsapp}
					target="_blank"
					rel="noopener"
					class="mt-8 inline-flex items-center gap-2 rounded-full bg-brand-shadow px-8 py-4 font-bold text-brand-bg shadow-xl transition hover:-translate-y-0.5 hover:bg-brand-text"
				>
					Start your order →
				</a>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	const INTERVAL = 5000;
	const FLIP_MS = 900;
	let timer: number | undefined;

	function stop() {
		clearInterval(timer);
		timer = undefined;
	}

	function init() {
		stop();
		const deck = document.getElementById("hero-deck");
		if (!deck) return;

		const cards = Array.from(deck.querySelectorAll<HTMLElement>(".hero-card"));
		const dots = Array.from(deck.querySelectorAll<HTMLElement>(".hero-dot"));
		if (cards.length < 2) return;

		const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
		let order = cards.map((_, i) => i); // order[0] = card currently in front
		let busy = false;

		const paint = () => {
			cards.forEach((c, i) => c.setAttribute("aria-hidden", String(order[0] !== i)));
			dots.forEach((d, i) => d.classList.toggle("is-active", i === order[0]));
		};

		const advance = () => {
			if (!deck.isConnected) return stop();
			if (busy) return;
			busy = true;

			const leaving = cards[order[0]];
			order.push(order.shift()!);

			// Promote the next two cards (they animate via CSS transitions)
			cards[order[0]].dataset.pos = "0";
			cards[order[1]].dataset.pos = "1";
			paint();

			if (reduce.matches) {
				leaving.dataset.pos = "2";
				busy = false;
				return;
			}

			// Front card flips away, then slips in at the back of the stack
			leaving.classList.add("is-leaving");
			setTimeout(() => {
				leaving.classList.add("is-resetting");
				leaving.classList.remove("is-leaving");
				leaving.dataset.pos = "2";
				void leaving.offsetWidth; // commit the jump while hidden
				leaving.classList.remove("is-resetting");
				busy = false;
			}, FLIP_MS);
		};

		const start = () => {
			stop();
			timer = window.setInterval(advance, INTERVAL);
		};

		document.addEventListener(
			"visibilitychange",
			() => (document.hidden ? stop() : deck.isConnected && start()),
			{ once: false },
		);
		start();
	}

	document.addEventListener("astro:page-load", init);
	document.addEventListener("astro:before-swap", stop);
</script>
