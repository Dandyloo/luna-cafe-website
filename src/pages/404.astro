---
// src/pages/404.astro
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Page not found – Luna Café & Eatery"
	description="That page doesn't exist. Head back to the Luna Café & Eatery menu."
	noindex
>
	<section class="relative isolate overflow-hidden">
		<div class="absolute inset-0 -z-10 bg-grain"></div>
		<div class="mx-auto max-w-2xl px-4 pt-40 pb-20 text-center sm:px-6 sm:pt-48">
			<p class="text-sm font-bold uppercase tracking-widest text-brand-deep">Error 404</p>
			<h1 class="mt-3 text-5xl font-extrabold text-brand-shadow md:text-6xl">
				This page went out of stock.
			</h1>
			<p class="mx-auto mt-4 max-w-md text-brand-text/70">
				The link may be old or mistyped. Let's get you back to the good stuff.
			</p>
			<div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
				<a
					href="/menu"
					class="inline-flex items-center justify-center rounded-full bg-brand-shadow px-8 py-4 font-bold text-brand-bg transition hover:-translate-y-0.5 hover:bg-brand-text"
				>
					View menu
				</a>
				<a
					href="/"
					class="inline-flex items-center justify-center rounded-full bg-brand-primary px-8 py-4 font-bold text-brand-text transition hover:-translate-y-0.5 hover:bg-brand-secondary hover:text-white"
				>
					Back home
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
